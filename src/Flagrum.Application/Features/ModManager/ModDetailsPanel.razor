@using System.IO
@using Flagrum.Abstractions.ModManager.Project
@using Flagrum.Application.Features.ModManager.Services
@using Flagrum.Application.Features.ModManager.FskImport

@{
    var files = Index.GetModFiles(Mod);
    var missingCount = files.Count(f => IsMissing(f.SourceFile));
    var hasReadme = !string.IsNullOrWhiteSpace(Mod.Readme) && Mod.Readme.Trim() != "<p><br></p>";
    var isFskMod = Parent.FskBuilds.IsFskMod(Mod.Identifier);
    var build = isFskMod ? Parent.FskBuilds.TryLoadBuild(Mod.Identifier) : null;
}

<div class="h-full flex flex-col bg-dark border-l border-dark-550" style="width: 400px; flex: 0 0 400px;">
    <div class="row px-4 py-3 border-b border-dark-550">
        <span class="text-grey-300 flex-grow font-display">Mod Details</span>
        <span class="material-icons cursor-pointer text-grey-400 hover:text-white" title="Close"
              @onclick="Parent.CloseDetailsPanel">close</span>
    </div>

    <div class="flex-grow overflow-auto">
        <div class="bg-grey-800"
             style="width: 100%; height: 200px; background-repeat: no-repeat; background-size: cover; background-position: center; background-image: url('@Parent.GetImageUrl(Mod.Identifier)')">
        </div>

        <div class="p-4">
            <h4 class="text-grey-200 font-display mb-1" style="overflow-wrap: anywhere;">@Mod.Name</h4>
            @if (!string.IsNullOrWhiteSpace(Mod.Author))
            {
                <div class="row text-grey-400 mb-3">
                    <span class="material-icons mr-1.5" style="font-size: 1rem;">person</span>
                    <span>@Mod.Author</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Mod.Description))
            {
                <p class="text-sm text-grey-300 mb-4" style="white-space: pre-wrap;">@Mod.Description</p>
            }

            <div class="grid gap-2 text-sm mb-4" style="grid-template-columns: 90px 1fr; align-items: center;">
                <span class="text-grey-500">Status</span>
                <ModStatusButton Mod="Mod"/>

                <span class="text-grey-500">Category</span>
                <select class="bg-dark-600 text-grey-200 rounded px-2 py-1 border border-dark-550"
                        value="@Parent.ModMetadata.GetCategory(Mod.Identifier)"
                        @onchange="ChangeCategory">
                    @foreach (var category in Enum.GetValues<ModListCategory>())
                    {
                        <option value="@category">@category</option>
                    }
                </select>

                <span class="text-grey-500">Installed</span>
                <span class="text-grey-300">@Parent.ModMetadata.GetInstalledAt(Mod.Identifier).ToString("d MMMM yyyy, HH:mm")</span>
            </div>

            <div class="row flex-wrap mb-6">
                <Button Icon="edit_note" Text="Edit Files" CssClass="mr-2 mb-2" OnClick="() => Parent.EditMod(Mod)"/>
                <Button Icon="edit" Text="Edit Info" CssClass="mr-2 mb-2" OnClickAsync="() => Parent.EditModInfo(Mod)"/>
                <Button Icon="folder_open" Text="Open Folder" CssClass="mr-2 mb-2" OnClick="() => Parent.OpenModFolder(Mod)"/>
                @if (hasReadme)
                {
                    <Button Icon="description" Text="Readme" CssClass="mr-2 mb-2" OnClick="() => Parent.ShowReadme(Mod.Readme)"/>
                }
                <Button Icon="delete" Text="Delete" CssClass="mb-2" BgColor="bg-error" BgHover="bg-error-highlight"
                        OnClick="() => Parent.DeleteMod(Mod)"/>
            </div>

            @if (isFskMod)
            {
                var status = build == null ? (FskBuildStatus?)null : Parent.FskBuilds.GetStatus(build, Mod);
                <div class="rounded bg-grey-800 p-3 mb-6 text-sm">
                    <div class="row mb-2">
                        <span class="text-grey-300 font-display flex-grow">FSK Build</span>
                        @switch (status)
                        {
                            case null:
                                <span class="text-error">Folder not found</span>
                                break;
                            case FskBuildStatus.Changed:
                                <span class="rounded-sm px-1.5 text-xs bg-curseforge-dark text-white">Changed</span>
                                break;
                            case FskBuildStatus.Problem:
                                <span class="text-error">Has problems</span>
                                break;
                            default:
                                <span class="text-grey-500">Up to date</span>
                                break;
                        }
                    </div>
                    <div class="text-xs text-grey-500 mb-1" style="overflow-wrap: anywhere;">
                        @Parent.FskBuilds.GetBuildFolder(Mod.Identifier)
                    </div>
                    @if (Parent.FskBuilds.GetSyncedAt(Mod.Identifier) is { } syncedAt)
                    {
                        <div class="text-xs text-grey-500 mb-2">Last synced @syncedAt.ToString("d MMMM yyyy, HH:mm")</div>
                    }
                    @if (build?.Problems.Count > 0)
                    {
                        <div class="text-xs text-error mb-2" style="overflow-wrap: anywhere;">
                            @foreach (var problem in build.Problems.Take(5))
                            {
                                <div>@problem</div>
                            }
                        </div>
                    }
                    <div class="row flex-wrap">
                        <Button Icon="sync" Text="Re-sync" CssClass="mr-2 mb-2"
                                IsDisabled="@(build == null || Parent.BusyModId != null)"
                                OnClick="() => Parent.ResyncMod(Mod)"/>
                        @if (build?.BuildLog != null)
                        {
                            <Button Icon="article" Text="@(ShowBuildLog ? "Hide Build Log" : "Build Log")" CssClass="mb-2"
                                    OnClick="() => ShowBuildLog = !ShowBuildLog"/>
                            <span class="ml-2 mb-2 rounded-sm px-1.5 text-xs text-white @(build.Result == FskBuildResult.Fail ? "bg-error" : build.Result == FskBuildResult.Pass ? "bg-green-700" : "bg-grey-700")">
                                @(build.Result == FskBuildResult.Unknown ? "No result" : build.Result.ToString().ToUpper())
                            </span>
                        }
                    </div>
                    @if (ShowBuildLog && build?.BuildLog != null)
                    {
                        <pre class="text-xs text-grey-300 bg-dark rounded p-2 mt-1"
                             style="max-height: 260px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere;">@build.BuildLog</pre>
                    }
                </div>
            }

            <div class="row mb-2">
                <span class="text-grey-300 font-display flex-grow">Files (@files.Count)</span>
                @if (missingCount > 0)
                {
                    <span class="row text-sm text-error">
                        <span class="material-icons mr-1" style="font-size: 1rem;">warning</span>
                        @missingCount missing
                    </span>
                }
            </div>

            @if (files.Count == 0)
            {
                <span class="text-sm text-grey-500">This mod doesn't change any files yet.</span>
            }

            @foreach (var file in files)
            {
                var isMissing = IsMissing(file.SourceFile);
                <div class="rounded bg-grey-800 p-2 mb-2 text-xs" style="overflow-wrap: anywhere;">
                    <div class="row mb-1">
                        <span class="rounded-sm px-1.5 mr-2 bg-grey-700 text-grey-300" style="white-space: nowrap; flex-shrink: 0;">@file.Action</span>
                        <span class="text-grey-200">@file.GameFile</span>
                    </div>
                    @if (file.SourceFile != null)
                    {
                        <div class="row @(isMissing ? "text-error" : "text-grey-500")" title="@(isMissing ? "This file no longer exists" : null)">
                            <span class="material-icons mr-1" style="font-size: 0.8rem;">@(isMissing ? "warning" : "subdirectory_arrow_right")</span>
                            <span>@file.SourceFile</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code
{
    [CascadingParameter] public Index Parent { get; set; }

    [Parameter] public IFlagrumProject Mod { get; set; }

    private Guid _shownModId;
    private bool ShowBuildLog { get; set; }

    protected override void OnParametersSet()
    {
        // Collapse the build log again when a different mod is selected
        if (Mod.Identifier != _shownModId)
        {
            _shownModId = Mod.Identifier;
            ShowBuildLog = false;
        }
    }

    private static bool IsMissing(string path) => !string.IsNullOrWhiteSpace(path) && !File.Exists(path);

    private void ChangeCategory(ChangeEventArgs e)
    {
        if (Enum.TryParse<ModListCategory>(e.Value?.ToString(), out var category))
        {
            Parent.ModMetadata.SetCategory(Mod.Identifier, category);
            Parent.CallStateHasChanged();
        }
    }
}
